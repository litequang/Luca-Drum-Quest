{
  "name": "luca-drum-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/cli.ts migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx server/cli.ts seed",
    "admin:init": "node --env-file-if-exists=.env --import tsx server/cli.ts init-admin",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts",
    "media:cleanup": "node --env-file-if-exists=.env --import tsx server/cleanup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.2.2",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "mariadb": "^3.5.5",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
