# Configure on the hosting account, outside public_html. No actual secrets in this template.
HOST=127.0.0.1
# Keep a port supplied by your Node application manager if it sets one.
PORT=3000
APP_ORIGIN=https://your-domain.example
COOKIE_SECURE=true
DB_HOST=localhost
DB_PORT=3306
# Use the full cPanel-prefixed names.
DB_USER=
DB_PASSWORD=
DB_NAME=
# Prefer an absolute private path outside public_html and outside future upload packages.
MEDIA_DIR=./private-media
SESSION_HOURS=8
# Generate on your PC with npm run setup:key, then copy this value privately.
# Blank disables browser installation. Remove it after successful first setup.
SETUP_TOKEN=
