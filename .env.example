# Node 24 LTS + MariaDB 11.4 (or a compatible MariaDB 10.11+ server)
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=luca
DB_PASSWORD=
DB_NAME=luca_pilot
# Must be outside public assets. Never serve this directory statically.
MEDIA_DIR=./private-media
SESSION_HOURS=8
# true requires HTTPS APP_ORIGIN. Keep false ONLY on local HTTP loopback.
COOKIE_SECURE=false
# Set these temporarily ONLY for npm run admin:init, then remove them.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Integration tests require a separate empty database with a name ending _test.
TEST_DB_NAME=luca_pilot_test
